# Leave the Supabase values empty to run with built-in demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (scraper monitor page). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Protects /admin with a browser password prompt.
ADMIN_USER=admin
ADMIN_PASSWORD=
